# ============================================================
# Backend Xupply / Hackathon - Variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ============================================================

PORT=4000

# Base de datos PostgreSQL (local o en la nube: Neon, Render, Supabase...)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/xupply

# Obligatorio en produccion (el servidor no arranca sin esto fuera de desarrollo).
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value

# Lista blanca de origenes permitidos (CORS HTTP + Socket.IO), separados por coma.
# Si se deja vacio se permite cualquier origen (solo recomendado en desarrollo).
CLIENT_ORIGIN=http://localhost:5173

# Notificaciones por email (EmailJS) - opcional
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Agente XupAI (DeepSeek) - opcional
# La clave puede ir en XUPAI_API_KEY, DEEPSEEK_API_KEY u OPENAI_API_KEY.
XUPAI_API_KEY=
DEEPSEEK_API_KEY=
XUPAI_MODEL=deepseek-chat
XUPAI_BASE_URL=https://api.deepseek.com

# Notas:
# - En Vercel tambien se detectan automaticamente POSTGRES_URL, POSTGRES_URL_NON_POOLING,
#   POSTGRES_PRISMA_URL y las variables POSTGRES_HOST/USER/PASSWORD/DATABASE.
# - PGSSLMODE=require fuerza SSL si tu proveedor lo necesita.
